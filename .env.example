# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# --- Supabase ---
# Project URL and anon key are safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZzZGRiZHNteGtybW1mcXdjZmRqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY3NzU4NTksImV4cCI6MjEwMjM1MTg1OX0.5DWF3GvvC1PgFuiaA-MRim6XY4VrbBw5triXM7MO-4o
# Service role key bypasses Row Level Security — server-side only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- LLM ---
# Server-side only.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
