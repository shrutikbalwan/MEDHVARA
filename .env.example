# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# --- Supabase ---
# Project URL and anon key are safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=NEXT_PUBLIC_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=NEXT_PUBLIC_SUPABASE_ANON_KEY
# Service role key bypasses Row Level Security — server-side only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY

# --- LLM ---
# Server-side only. Never prefix these with NEXT_PUBLIC_ — that would inline the
# key into the browser bundle where anyone can read it.
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
